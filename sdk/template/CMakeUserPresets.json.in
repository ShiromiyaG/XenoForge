{
    "version": 6,
    "configurePresets": [
        {
            "name": "local",
            "displayName": "this machine's SDK and disc (@PORT_HOST_PRESET@)",
            "inherits": "@PORT_HOST_PRESET@",
            "binaryDir": "${sourceDir}/build/@PORT_HOST_PRESET@",
            "cacheVariables": {
                "XENOFORGE_SDK": "@PORT_SDK@",
                "GAME_ISO": "@PORT_ISO@"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "local",
            "configurePreset": "local"
        }
    ]
}
