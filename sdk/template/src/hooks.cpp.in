// @PORT_TITLE@: the port's hooks on guest functions (xenoforge/port.h;
// XenoForge's docs/recompiler.md, "Replacing and hooking"). With
// PORT_HOT_RELOAD (the default) they are a module of their own: edit, then
//   cmake --build build --target @PORT_NAME@_hooks
// and the running player takes them (F9 reloads at once). The module sees
// port.h alone; state kept across reloads goes in xf::port::persistent<T>(key).
//
// A function hooked here is listed in project.toml's `hooks`, so the
// generated code's direct calls reach it too:
//
//   XF_REPLACE(0x82012340, clamp_speed) {   // native code in its place
//       original(c);                        // the guest's own body
//       if (f(c, 1) > 30.0) set_f(c, 1, 30.0);
//   }
//   XF_BEFORE(0x82012400, count_frames) { persistent<uint64_t>("frames")++; }

#include <xenoforge/port.h>

using namespace xf::port;
