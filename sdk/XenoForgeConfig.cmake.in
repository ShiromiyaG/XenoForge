@PACKAGE_INIT@

# XenoForge, installed (docs/sdk.md): imported targets for the runtime's static
# libraries and the function xenoforge_add_port.
#
#   XenoForge::core      the recompiled code's runtime, the interpreter, the disc and executable readers
#   XenoForge::kernel    the system's exports (linked whole: they register by static initializers)
#   XenoForge::vk        the renderer on Vulkan
#   XenoForge::boot      boot as a library (xf::run_boot), for the headless executable
#   XenoForge::player    the player as a library (xf::run_player; only if XenoForge was built with it)
#   XenoForge::xfrecomp  the recompiler (an executable), and XenoForge_XFINSPECT beside it

include(CMakeFindDependencyMacro)

# The libraries are built for the release runtime: a port built as Debug does not
# link (the linker refuses the mismatch). Set CMAKE_BUILD_TYPE before project().
if(CMAKE_BUILD_TYPE STREQUAL "Debug" OR NOT CMAKE_BUILD_TYPE AND NOT CMAKE_CONFIGURATION_TYPES)
    message(WARNING "XenoForge: its libraries are built optimized; use -DCMAKE_BUILD_TYPE=RelWithDebInfo (or set it before project())")
endif()

set(XENOFORGE_PLAYER @XF_SDK_PLAYER@)
set(XENOFORGE_INCLUDE_DIR "${PACKAGE_PREFIX_DIR}/include")
set(_xf_lib "${PACKAGE_PREFIX_DIR}/lib")
set(_xf_pre "@CMAKE_STATIC_LIBRARY_PREFIX@")
set(_xf_suf "@CMAKE_STATIC_LIBRARY_SUFFIX@")

# a static library of the package
macro(_xf_static target file)
    add_library(${target} STATIC IMPORTED)
    set_target_properties(${target} PROPERTIES IMPORTED_LOCATION "${_xf_lib}/${_xf_pre}${file}${_xf_suf}"
                                               IMPORTED_LINK_INTERFACE_LANGUAGES CXX)
    if(NOT EXISTS "${_xf_lib}/${_xf_pre}${file}${_xf_suf}")
        set(XenoForge_FOUND FALSE)
        set(XenoForge_NOT_FOUND_MESSAGE "XenoForge: ${_xf_lib}/${_xf_pre}${file}${_xf_suf} is missing")
    endif()
endmacro()

# Khronos's Vulkan and SPIR-V headers and volk come with the package (cmake/vulkan.cmake): no Vulkan SDK
set(_xf_includes "${XENOFORGE_INCLUDE_DIR}" "${XENOFORGE_INCLUDE_DIR}/spirv-headers")

_xf_static(XenoForge::core xenoforge)
set_target_properties(XenoForge::core PROPERTIES INTERFACE_INCLUDE_DIRECTORIES "${_xf_includes}"
                                                 INTERFACE_COMPILE_FEATURES cxx_std_20)
if(UNIX)
    set_property(TARGET XenoForge::core APPEND PROPERTY INTERFACE_LINK_LIBRARIES ${CMAKE_DL_LIBS} Threads::Threads)
    find_dependency(Threads)
endif()

# volk: Vulkan's functions loaded from the system's loader at run time (no prototypes, no import library)
_xf_static(XenoForge::volk xenoforge_volk)
set_target_properties(XenoForge::volk PROPERTIES INTERFACE_COMPILE_DEFINITIONS VK_NO_PROTOTYPES
                                                 INTERFACE_LINK_LIBRARIES "${CMAKE_DL_LIBS}"
                                                 IMPORTED_LINK_INTERFACE_LANGUAGES C)
_xf_static(XenoForge::vk xenoforge_vk)
set_target_properties(XenoForge::vk PROPERTIES INTERFACE_LINK_LIBRARIES "XenoForge::core;XenoForge::volk")

_xf_static(XenoForge::kernel_archive xenoforge_kernel)
# the archive's own dependencies, so the link puts it before them: a linker that
# reads archives once, in order (GNU ld, lld on ELF), finds core's symbols then
set_target_properties(XenoForge::kernel_archive PROPERTIES INTERFACE_LINK_LIBRARIES "XenoForge::vk;XenoForge::core")
add_library(XenoForge::kernel INTERFACE IMPORTED)
set_target_properties(XenoForge::kernel PROPERTIES
    INTERFACE_LINK_LIBRARIES "$<LINK_LIBRARY:WHOLE_ARCHIVE,XenoForge::kernel_archive>;XenoForge::vk;XenoForge::core")
if(WIN32)
    set_property(TARGET XenoForge::kernel APPEND PROPERTY INTERFACE_LINK_LIBRARIES ws2_32 dbghelp)
endif()

_xf_static(XenoForge::boot xenoforge_boot)
set_target_properties(XenoForge::boot PROPERTIES INTERFACE_LINK_LIBRARIES "XenoForge::vk;XenoForge::core")

if(XENOFORGE_PLAYER)
    _xf_static(XenoForge::player xenoforge_player)
    _xf_static(XenoForge::_frontend xf_frontend)
    _xf_static(XenoForge::_imgui xf_imgui)
    set_target_properties(XenoForge::_imgui PROPERTIES INTERFACE_COMPILE_DEFINITIONS IMGUI_IMPL_VULKAN_USE_VOLK)
    _xf_static(XenoForge::_sdl3 SDL3-static)
    # SDL3's system libraries, as the build that made the package linked them
    set(_xf_sdl_libs)
    if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/sdl3_system_libs.txt")
        file(READ "${CMAKE_CURRENT_LIST_DIR}/sdl3_system_libs.txt" _xf_sdl_text)
        string(STRIP "${_xf_sdl_text}" _xf_sdl_text)
        # (the property as written: plain names and $<LINK_ONLY:name>; targets such as SDL3::Headers are dropped)
        foreach(_xf_item ${_xf_sdl_text})
            if(_xf_item MATCHES "^\\$<LINK_ONLY:([^>:]+)>$")
                list(APPEND _xf_sdl_libs ${CMAKE_MATCH_1})
            elseif(NOT _xf_item MATCHES "::|\\$<")
                list(APPEND _xf_sdl_libs ${_xf_item})
            endif()
        endforeach()
    endif()
    set_target_properties(XenoForge::_sdl3 PROPERTIES INTERFACE_LINK_LIBRARIES "${_xf_sdl_libs}")
    set_target_properties(XenoForge::player PROPERTIES
        INTERFACE_LINK_LIBRARIES "XenoForge::_frontend;XenoForge::_imgui;XenoForge::_sdl3;XenoForge::vk;XenoForge::core")
endif()

# xfrecomp runs at build time, on the build machine: a package built for
# another host (ARM64 Linux, Android) is used with an SDK built for the build
# machine beside it, whose xfrecomp xenoforge_add_port takes from here
set(XENOFORGE_HOST_XFRECOMP "" CACHE FILEPATH "cross-compiling: the xfrecomp of an SDK built for the build machine")
add_executable(XenoForge::xfrecomp IMPORTED)
set_target_properties(XenoForge::xfrecomp PROPERTIES IMPORTED_LOCATION
                      "${PACKAGE_PREFIX_DIR}/bin/xfrecomp${CMAKE_EXECUTABLE_SUFFIX}")
add_executable(XenoForge::xfshader IMPORTED)
set_target_properties(XenoForge::xfshader PROPERTIES IMPORTED_LOCATION
                      "${PACKAGE_PREFIX_DIR}/bin/xfshader${CMAKE_EXECUTABLE_SUFFIX}")
add_executable(XenoForge::xfinspect IMPORTED)
set_target_properties(XenoForge::xfinspect PROPERTIES IMPORTED_LOCATION
                      "${PACKAGE_PREFIX_DIR}/bin/xfinspect${CMAKE_EXECUTABLE_SUFFIX}")

# what a port copies beside its executables (the sound's decoder, loaded at run time)
set(XENOFORGE_RUNTIME_FILES)
if(@XF_SDK_XMA@)
    set(XENOFORGE_RUNTIME_FILES "${PACKAGE_PREFIX_DIR}/bin/@CMAKE_SHARED_LIBRARY_PREFIX@ffmpeg-xma@CMAKE_SHARED_LIBRARY_SUFFIX@")
endif()

include("${CMAKE_CURRENT_LIST_DIR}/xenoforge_port.cmake")
