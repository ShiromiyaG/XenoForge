// A render target's samples into EDRAM, in the tiles the mask marks
// (renderer.cpp). MS: the target is multisampled. A depth target whose
// format the host encodes differently keeps its own depth beside EDRAM too
// (edram.glsl's host_depth_offset), for the loads to take back where EDRAM's
// 24 bits still are what it rounds to. BSD; see LICENSE-xenia.
#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_samplerless_texture_functions : require

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) buffer Edram { uint words[]; } edram;
layout(set = 0, binding = 1) readonly buffer Mask { uint tiles[]; } mask;
#ifdef MS
layout(set = 0, binding = 2) uniform texture2DMS source;   // color, or depth
layout(set = 0, binding = 3) uniform utexture2DMS stencil; // depth targets', or a float target's UINT view
#else
layout(set = 0, binding = 2) uniform texture2D source;
layout(set = 0, binding = 3) uniform utexture2D stencil; // or a float target's UINT view
#endif
layout(set = 0, binding = 4) writeonly buffer HostDepth { uint words[]; } host_depth;

#include "edram.glsl"

void main() {
    uvec2 pixel = gl_GlobalInvocationID.xy;
    if (pixel.x >= target.width || pixel.y >= target.height) return;
    uint samples = target.msaa == 0u ? 1u : target.msaa == 1u ? 2u : 4u;
    for (uint host = 0u; host < samples; host++) {
        uint at = edram_offset(pixel, guest_sample(host));
        if (mask.tiles[at / TILE_DWORDS] == 0u) continue;
#ifdef MS
        vec4 value = texelFetch(source, ivec2(pixel), int(host));
#else
        vec4 value = texelFetch(source, ivec2(pixel), 0);
#endif
        if (target.is_depth != 0u) {
#ifdef MS
            uint s = texelFetch(stencil, ivec2(pixel), int(host)).r;
#else
            uint s = texelFetch(stencil, ivec2(pixel), 0).r;
#endif
            edram.words[at] = pack_depth(value.r, s);
            if ((target.flags & 1u) != 0u) host_depth.words[host_depth_offset(at)] = floatBitsToUint(value.r);
        } else {
            uvec2 bits;
            if ((target.flags & 8u) != 0u) {
#ifdef MS
                bits = pack_raw(texelFetch(stencil, ivec2(pixel), int(host)));
#else
                bits = pack_raw(texelFetch(stencil, ivec2(pixel), 0));
#endif
            } else {
                bits = pack_color(value);
            }
            edram.words[at] = bits.x;
            if (target.ints_log2 != 0u) edram.words[at + 1u] = bits.y;
        }
    }
}
