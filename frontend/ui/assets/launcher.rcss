/*
 * XenoForge launcher, the main window: the menu bar, the toolbar, the games
 * table and the status bar, in the manner of the classic emulator front ends.
 * theme.rcss comes before this file; the {tokens} are filled in the same way.
 */

#app { position: absolute; left: 0; top: 0; width: 100%; height: 100%; display: flex; flex-direction: column; }

/* ---------------------------------------------------------------- menu bar */

#menubar {
    flex: 0 0 auto; height: 30dp; display: flex; flex-direction: row; align-items: center;
    padding: 0 4dp; background-color: {chrome};
}
.menu-title { height: 24dp; line-height: 24dp; padding: 0 10dp; border-radius: 4dp; color: {text}; cursor: pointer; }
.menu-title:hover { background-color: {hover}; }
.menu-title.open { background-color: {press}; }

/* ----------------------------------------------------------------- toolbar */

#toolbar {
    flex: 0 0 auto; height: 44dp; display: flex; flex-direction: row; align-items: center;
    padding: 0 6dp; background-color: {chrome}; border-bottom: 1dp {border};
}
.tb {
    display: flex; flex-direction: row; align-items: center;
    height: 32dp; padding: 0 10dp; margin-right: 2dp; border-radius: 4dp;
    color: {text}; cursor: pointer; white-space: nowrap;
}
.tb .ic { font-size: 16dp; margin-right: 7dp; color: {text-2}; }
.tb.primary .ic { color: {accent}; }
.tb:hover { background-color: {hover}; }
.tb:active { background-color: {press}; }
.tb:focus-visible { background-color: {hover}; box-shadow: 0 0 0 2dp {accent40}; }
.tb.off { opacity: 0.4; cursor: default; }
.tb.off:hover { background-color: transparent; }
.tb.stop .ic { color: {bad}; }
.tb-sep { flex: 0 0 1dp; width: 1dp; height: 20dp; margin: 0 6dp; background-color: {border}; }
#tb-space { flex: 1 1 0; }
#search-box {
    display: flex; flex-direction: row; align-items: center;
    width: 250dp; height: 28dp; padding: 0 4dp 0 9dp; margin-right: 4dp;
    border: 1dp {border-strong}; border-radius: 4dp; background-color: {input};
}
#search-box .ic { font-size: 14dp; margin-right: 6dp; color: {text-3}; }
#search { flex: 1 1 0; width: 100dp; height: 24dp; padding: 4dp 2dp; border: 0; background-color: transparent; }
#search:focus { border: 0; }
#search-clear { display: none; width: 20dp; height: 20dp; line-height: 20dp; text-align: center; border-radius: 3dp; font-family: Lucide; font-size: 12dp; color: {text-2}; cursor: pointer; }
#search-clear.on { display: block; }
#search-clear .ic { font-size: 12dp; line-height: 20dp; }
#search-clear:hover { background-color: {hover}; }

/* ------------------------------------------------------------------- table */

#table { position: relative; flex: 1 1 0; min-height: 0; display: flex; flex-direction: column; background-color: {bg}; }
#thead {
    flex: 0 0 auto; height: 28dp; display: flex; flex-direction: row;
    background-color: {head}; border-bottom: 1dp {border}; overflow: hidden;
}
.th {
    position: relative; display: flex; flex-direction: row; align-items: center;
    height: 27dp; padding: 0 8dp; border-right: 1dp {border};
    color: {text-2}; font-size: 12dp; font-weight: 500; cursor: pointer; overflow: hidden;
}
.th.c-icon { cursor: default; }
.th:hover { background-color: {hover}; color: {text}; }
.th.c-icon:hover { background-color: transparent; }
.th.sorted { color: {text}; }
.th-l { flex: 0 1 auto; min-width: 0; }
.th .arrow { font-size: 12dp; margin-left: 5dp; color: {text-2}; }
.grip { position: absolute; right: 0; top: 0; width: 7dp; height: 27dp; cursor: resize; }
.grip:hover { background-color: {accent40}; }

#tbody { flex: 1 1 0; min-height: 0; overflow-y: auto; overflow-x: hidden; }
.tr { display: flex; flex-direction: row; align-items: center; height: 30dp; cursor: default; }
.tr.alt { background-color: {bg-alt}; }
.tr:hover { background-color: {hover}; }
.tr.sel { background-color: {sel}; }
.tr.sel:focus { background-color: {sel-strong}; }
.td { height: 30dp; line-height: 30dp; padding: 0 8dp; white-space: nowrap; overflow: hidden; color: {text}; }
.td.c-icon { padding: 0 0 0 7dp; }
.td.c-title { font-weight: 500; }
.td.c-id, .td.c-ver, .td.c-runs, .td.c-file { color: {text-2}; }
.tr.broken .td { color: {text-3}; }
.thumb { width: 22dp; height: 22dp; margin-top: 4dp; border-radius: 3dp; }
.thumb .letter { width: 22dp; height: 22dp; line-height: 22dp; text-align: center; font-size: 11dp; font-weight: 700; color: #ffffffe0; }
.thumb.broken { text-align: center; line-height: 22dp; color: {bad}; }
.thumb.broken .ic { font-size: 14dp; }
.status { display: flex; flex-direction: row; align-items: center; height: 30dp; }

#tempty { position: absolute; left: 0; top: 28dp; width: 100%; bottom: 0; display: none; }
#tempty.on { display: flex; flex-direction: column; align-items: center; justify-content: center; }
.empty { display: flex; flex-direction: column; align-items: center; width: 460dp; }
.empty .big-ic { font-family: Lucide; font-size: 46dp; line-height: 1; color: {text-3}; margin-bottom: 14dp; }
.empty-title { font-size: 15dp; font-weight: 600; margin-bottom: 6dp; }
.empty-text { color: {text-2}; text-align: center; }
.empty-buttons { display: flex; flex-direction: row; margin-top: 16dp; }
.empty-buttons .btn { margin: 0 4dp; }

/* -------------------------------------------------------------- status bar */

#statusbar {
    flex: 0 0 auto; height: 26dp; display: flex; flex-direction: row; align-items: center;
    padding: 0 6dp; background-color: {chrome}; border-top: 1dp {border};
    color: {text-2}; font-size: 12dp;
}
.st { padding: 0 8dp; white-space: nowrap; }
.st-sep { flex: 0 0 1dp; width: 1dp; height: 14dp; background-color: {border}; }
#st-folder { flex: 1 1 0; min-width: 0; overflow: hidden; text-overflow: ellipsis; cursor: pointer; }
#st-folder:hover { color: {text}; }
#st-message { flex: 0 1 auto; min-width: 0; overflow: hidden; text-overflow: ellipsis; display: flex; flex-direction: row; align-items: center; }
#st-message.err { color: {bad}; }
#st-message.ok { color: {text}; }
.st-link { color: {link}; cursor: pointer; margin-left: 8dp; }
.st-link:hover { text-decoration: underline; }
#st-progress { display: none; flex-direction: row; align-items: center; cursor: pointer; }
#st-progress.on { display: flex; }
.minibar { width: 110dp; height: 6dp; margin-left: 8dp; border-radius: 3dp; background-color: {border}; }
.minibar-fill { height: 6dp; border-radius: 3dp; background-color: {accent}; }

/* ---------------------------------------------------------- prepare dialog */

.prep-head { display: flex; flex-direction: row; align-items: center; margin-bottom: 16dp; }
.prep-icon { flex: 0 0 48dp; width: 48dp; height: 48dp; border-radius: 6dp; margin-right: 14dp; }
.prep-icon .letter { width: 48dp; height: 48dp; line-height: 48dp; text-align: center; font-size: 20dp; font-weight: 700; color: #ffffffe0; }
.prep-title { font-size: 15dp; font-weight: 600; }
.prep-state { display: flex; flex-direction: row; align-items: center; margin-top: 3dp; }
.stages { display: flex; flex-direction: row; margin-bottom: 14dp; }
.stage { flex: 1 1 0; margin-right: 6dp; }
.stage .bar { height: 4dp; border-radius: 2dp; background-color: {border}; }
.stage .in { height: 4dp; border-radius: 2dp; background-color: {accent}; width: 0%; }
.stage .nm { margin-top: 5dp; font-size: 11.5dp; color: {text-3}; }
.stage.now .nm { color: {text}; font-weight: 500; }
.stage.done .nm { color: {text-2}; }
.stage.bad .in { background-color: {bad}; }
.stage.bad .nm { color: {bad}; }
.pbar { height: 8dp; border-radius: 4dp; background-color: {border}; }
.pfill { height: 8dp; border-radius: 4dp; background-color: {accent}; width: 0%; }
.pbar.failed .pfill { background-color: {bad}; }
.pbar.done .pfill { background-color: {good}; }
.prep-meta { display: flex; flex-direction: row; align-items: center; margin-top: 8dp; }
#prep-count b { font-weight: 600; }
.prep-file { margin-top: 3dp; height: 18dp; font-size: 12dp; color: {text-3}; }
.errbox { display: none; margin-top: 10dp; padding: 10dp 12dp; border-radius: 4dp; border: 1dp {bad}; color: {text}; }
.errbox.on { display: block; }
.log-toggle { display: flex; flex-direction: row; align-items: center; margin-top: 12dp; color: {link}; cursor: pointer; }
.log-toggle .chev { font-size: 13dp; margin-right: 4dp; }
.log-toggle.open .chev { transform: rotate(180deg); }
.log {
    display: none; margin-top: 8dp; height: 180dp; padding: 8dp 10dp; overflow-y: auto;
    border: 1dp {border}; border-radius: 4dp; background-color: {input}; font-size: 12dp; color: {text-2};
}
.log.open { display: block; }
.log .l { white-space: nowrap; }
.log .l.head { color: {text}; }
.log .l.err { color: {bad}; }

/* ------------------------------------------------------------ about dialog */

.about-head { display: flex; flex-direction: row; align-items: center; margin-bottom: 12dp; }
.mark {
    width: 38dp; height: 38dp; border-radius: 9dp; margin: 0 16dp 0 4dp; transform: rotate(45deg);
    decorator: linear-gradient(135deg, {accent-hi}, {accent-lo});
}
.mark-core { position: absolute; left: 12dp; top: 12dp; width: 14dp; height: 14dp; border-radius: 3dp; background-color: {dialog}; }
.about-name { font-size: 18dp; font-weight: 700; }
.about-ver { color: {text-2}; font-size: 12dp; }
.about-text { margin-bottom: 10dp; }
.about-note { padding: 9dp 11dp; border-radius: 4dp; background-color: {hover}; color: {text-2}; font-size: 12dp; }
.about-licenses { margin: 16dp 0 4dp 0; font-weight: 600; }
.lic { padding: 8dp 0; border-bottom: 1dp {border}; }
.lic-top { display: flex; flex-direction: row; align-items: center; }
.lic-name { font-weight: 500; flex: 1 1 0; }
.lic-tag { font-size: 11.5dp; color: {text-2}; padding: 1dp 7dp; border: 1dp {border-strong}; border-radius: 9dp; }
.lic-text { margin-top: 3dp; color: {text-2}; font-size: 12dp; }
.about-foot { margin-top: 12dp; font-size: 12dp; }
#st-message .st-ic { font-size: 12dp; margin-right: 6dp; color: {accent}; }
.msg { max-width: 100%; }
/* the menus' layer starts below the menu bar, so the bar's titles stay live while a menu is open */
#menu-layer { top: 30dp; height: auto; bottom: 0; }
/* the open menu itself, placed in the window's coordinates from this corner */
#menu-host { position: absolute; left: 0; top: 0; width: 0; height: 0; }
