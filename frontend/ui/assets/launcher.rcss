/*
 * XenoForge launcher, the main window: a header with the wordmark and the
 * sections, a toolbar, the games as glossy rows, the hints for the controls
 * and a status bar, in the manner of the console's own dashboard. Its colours
 * are tokens in braces (launcher_model.cpp, palette(): the glass, the glossy buttons,
 * the slots, the text over the backdrop; and the accent's tones, the ac- ones), so
 * the light or dark theme and the accent are the user's: dark is grey glass
 * under white text, light is pearl glass under graphite text. Sizes are dp,
 * drawn for a window 1240dp wide. theme.rcss comes before this file.
 */

/* no background of its own: the renderer draws the window's backdrop under it (the grey gradient this
   used to be, with the ribbons; ui.frag's MODE_BACKDROP, set by LauncherView::update_backdrop) */
body { background-color: transparent; }
#app {
    position: absolute; left: 0; top: 0; width: 100%; height: 100%; display: flex; flex-direction: column;
}

/* ------------------------------------------------------- the stage and its pages
   the library and the settings sit side by side on a strip twice the stage's width; choosing a section
   slides the strip, as the console's dashboard slides from one blade to the next */

#stage { position: relative; flex: 1 1 0; min-height: 0; overflow: hidden; }
/* (a transform, not `left`: moving the strip by `left` lays the whole document out again on every frame of the slide) */
#slide { position: absolute; left: 0; top: 0; bottom: 0; width: 200%; display: flex; flex-direction: row; transition: transform 0.34s cubic-out; }
/* (100vw, not -50%: RmlUi does not resolve the percentage again when the window changes size, so a window
   maximized or made fullscreen while on the settings page kept the old width's offset, the page shoved off to the right;
   viewport units are made again by every change of the context's size) */
#slide.to-settings { transform: translateX(-100vw); }
.page-side { flex: 0 0 50%; min-width: 0; display: flex; flex-direction: column; }
/* (no opacity on the pages: each one would be drawn into a layer of its own, the window's size, on every frame of the slide,
   which doubled the frame's time) */
.page-side.hidden { visibility: hidden; }

/* ------------------------------------------------------------------ header */

#header {
    flex: 0 0 auto; height: 74dp; display: flex; flex-direction: row; align-items: center;
    padding: 0 12dp 0 19dp;
    decorator: linear-gradient(90deg, {hd-a}, {hd-b} 45%, {hd-c});
}
#brand { flex: 0 0 236dp; font-weight: 300; font-size: 29dp; line-height: 1; color: {hd-text}; white-space: nowrap; }
/* the same diamond as the About dialog's, with the header's own colour in its core */
#brand .mark { width: 42dp; height: 42dp; margin: 0 0 0 14dp; }
#brand .mark-core { left: 13dp; top: 13dp; width: 16dp; height: 16dp; background-color: {mark-core}; }
#nav { flex: 0 0 auto; display: flex; flex-direction: row; align-items: center; }
.nav {
    padding: 0 17dp; font-weight: 300; font-size: 29.5dp; line-height: 1; white-space: nowrap;
    color: {nav}; cursor: pointer; transition: color 0.18s cubic-out;
}
.nav:hover { color: {nav-hover}; }
.nav.open { color: {nav-on}; }
.nav.on { color: {nav-on}; font-weight: 400; font-size: 33dp; }
.nav:focus-visible { color: {nav-on}; }


/* --------------------------------------------------------------- search bar
   above the list, there only while the list has games; a recessed slot, the rows' counterpart: they are raised, this is let in */

#searchbar { display: none; flex: 0 0 auto; height: 52dp; padding: 12dp 8.8% 0 8.8%; flex-direction: row; align-items: center; }
#table.has-games #searchbar { display: flex; }
#search-box {
    flex: 1 1 0; display: flex; flex-direction: row; align-items: center; height: 38dp; padding: 0 8dp 0 14dp;
    border: 2dp {slot-border}; border-radius: 9dp;
    decorator: linear-gradient(180deg, {slot-0}, {slot-1});
    box-shadow: 0 1dp 0 0 {slot-lip}, inset 0 2dp 6dp 0 {slot-inset};
    transition: border-color 0.16s cubic-out;
}
#search-box:hover { border-color: {slot-border-h}; }
#search-box.focus {
    border-color: {ac-edge}; decorator: linear-gradient(180deg, {slot-f0}, {slot-f1});
    box-shadow: 0 0 0 1dp {ac-ring}, 0 0 14dp 2dp {ac-glow}90, inset 0 2dp 6dp 0 {slot-inset};
}
#search-box .ic { font-size: 18dp; margin-right: 10dp; color: {g-text-3}; }
#search-box.focus .ic { color: {ac-shine}; }
#search { flex: 1 1 0; width: 100dp; height: 34dp; padding: 0 2dp; line-height: 34dp; border: 0; background-color: transparent; font-family: Condensed; font-size: 21dp; color: {g-text}; }
#search:focus { border: 0; }
#search:placeholder-shown { color: {g-text-3}; }
#search-clear { display: none; width: 24dp; height: 24dp; line-height: 24dp; text-align: center; border-radius: 12dp; cursor: pointer; }
#search-clear.on { display: block; }
#search-clear .ic { font-size: 14dp; line-height: 24dp; color: {g-ic}; margin: 0; }
#search-clear:hover { background-color: {hover}; }

/* ----------------------------------------------------------------- toolbar */

#toolbar, #tabs {
    flex: 0 0 auto; height: 42dp; display: flex; flex-direction: row; align-items: center;
    padding: 0 19dp; border-top: 1dp {bar-top}; border-bottom: 1dp {bar-bot};
    decorator: linear-gradient(90deg, {bar-a}, {bar-b});
}
.tb, .tab {
    display: flex; flex-direction: row; align-items: center;
    height: 28dp; padding: 0 7dp 0 6dp; margin-right: 7dp; border: 1.5dp {btn-border}; border-radius: 6dp;
    decorator: linear-gradient(180deg, {btn-0} 0%, {btn-1} 40%, {btn-2} 62%, {btn-3} 100%);
    box-shadow: 0 0 0 1dp {btn-ring}, 0 2dp 3dp 1dp {btn-drop}, inset 0 1dp 1dp 0 {btn-inset};
    font-family: Condensed; font-size: 16dp; font-weight: 400; color: {btn-text}; cursor: pointer; white-space: nowrap;
    transition: decorator 0.14s cubic-out, border-color 0.14s cubic-out, opacity 0.2s cubic-out; /* (a box-shadow cannot be animated: RmlUi says so) */
}
.tb .ic, .tab .ic { font-size: 19dp; margin-right: 6dp; color: {btn-text}; }
.tb.primary .ic { color: #f28a38; }
.tb:hover, .tab:hover { border-color: {btn-h-border}; decorator: linear-gradient(180deg, {btn-h0} 0%, {btn-h1} 40%, {btn-h2} 62%, {btn-h3} 100%); }
.tb:active, .tab:active { decorator: linear-gradient(180deg, {btn-p0} 0%, {btn-p1} 40%, {btn-p2} 62%, {btn-p3} 100%); box-shadow: 0 0 0 1dp {btn-ring}, 0 0 0 0 #00000000, inset 0 1dp 3dp 0 {btn-p-inset}; }
.tb:focus-visible, .tab:focus-visible { border-color: {btn-focus}; }
/* the same number of stops and shadows as the plain button, so the change blends (the gradient's colours are those of the old two stops) */
.tb.on, .tb.on:hover, .tab.active, .tab.active:hover {
    border-color: {ac-edge}; decorator: linear-gradient(180deg, {ac-top} 0%, {ac-b1} 40%, {ac-b2} 62%, {ac-low} 100%);
    box-shadow: 0 0 0 1dp {ac-ring}, 0 0 0 0 #00000000, inset 0 1dp 1dp 0 #ffffff40;
    color: {sel-text};
}
.tb.on .ic, .tab.active .ic { color: {sel-text}; }
.tb.off { opacity: 0.5; cursor: unavailable; }
.tb.off:hover { border-color: {btn-border}; decorator: linear-gradient(180deg, {btn-0} 0%, {btn-1} 40%, {btn-2} 62%, {btn-3} 100%); }
.tb.stop .ic { color: {bad-ic}; }
#tb-space { flex: 1 1 0; }

/* ------------------------------------------------------------------- table */

#table { position: relative; flex: 1 1 0; min-height: 0; display: flex; flex-direction: column; }
#thead { flex: 0 0 auto; height: 38dp; padding: 0 8.8%; display: flex; flex-direction: row; align-items: center; }
.th {
    display: flex; flex-direction: row; align-items: center; height: 38dp;
    font-family: Condensed; font-weight: 400; font-size: 19.5dp; line-height: 1; color: #f0f0f2; cursor: pointer; text-transform: uppercase;
}
.th.c-opts { cursor: default; }
.th:hover { color: #ffffff; }
.th.c-opts:hover { color: #f0f0f2; }
.th.sorted { color: #ffffff; font-weight: 400; }
.th .arrow { font-size: 14dp; margin-left: 5dp; color: #ffffff; }
.c-game { flex: 1 1 0; min-width: 160dp; }
.th.c-game { padding-left: 4dp; }
.c-status { flex: 0 0 auto; width: 208dp; }
.c-id { flex: 0 0 auto; width: 176dp; }
.c-ver { flex: 0 0 auto; width: 159dp; }
.c-opts { flex: 0 0 auto; width: 100dp; }
.th.c-opts { justify-content: center; }

/* room around the rows for the selected one's glow, which the list's clipping would cut */
#tbody { flex: 1 1 0; min-height: 0; margin-top: -12dp; padding: 16dp 8.8% 20dp 8.8%; overflow-y: auto; overflow-x: hidden; }
.tr {
    position: relative; /* (left: the rows slide in, LauncherView::animate_rows_in) */
    display: flex; flex-direction: row; align-items: center; height: 66dp; margin: 0 0 8dp 0; cursor: pointer;
    border: 2dp {row-border}; border-radius: 9dp;
    decorator: radial-gradient(ellipse 17% 125% at 25.7% 0%, {row-shine}, #ffffff00),
               radial-gradient(ellipse 17% 125% at 75.4% 0%, {row-shine}, #ffffff00),
               linear-gradient(180deg, {row-0} 0%, {row-1} 55%, {row-2} 95%, {row-3} 100%);
    box-shadow: 0 0 0 1dp {row-ring}, 0 3dp 6dp 1dp {row-drop}, inset 0 1dp 0 0 {row-inset};
    /* the selection's change is a fade out of one row and a fade in of the next, the borders and margins growing and shrinking to match
       (and the glow, which is a box-shadow and cannot be animated, a child of the row whose opacity is: LauncherView::fade_glow);
       the gradients have the same layers and stops in each state, so they blend */
    transition: decorator 0.2s cubic-out, border-color 0.2s cubic-out, border-width 0.2s cubic-out, margin 0.2s cubic-out;
}
.tr:hover {
    border-color: {row-border-h};
    decorator: radial-gradient(ellipse 17% 125% at 25.7% 0%, {row-shine-h}, #ffffff00),
               radial-gradient(ellipse 17% 125% at 75.4% 0%, {row-shine-h}, #ffffff00),
               linear-gradient(180deg, {row-h0} 0%, {row-h1} 55%, {row-h2} 95%, {row-h3} 100%);
}
.tr.sel, .tr.sel:hover {
    border: 3dp {ac-edge}; border-radius: 10dp; margin: -2dp -2dp 6dp -2dp; border-color: {ac-edge};
    decorator: radial-gradient(ellipse 17% 125% at 25.7% 0%, #ffffff4a, #ffffff00),
               radial-gradient(ellipse 17% 125% at 75.4% 0%, #ffffff4a, #ffffff00),
               linear-gradient(180deg, {ac-top}e0 0%, {ac-mid}e0 55%, {ac-low}e0 95%, {ac-end}e0 100%);
    box-shadow: none; /* the glow below is the shadow */
}
/* the selected row's glow and its green ring, over the row's own background (its text comes after, so on top of it) */
.tr .glow {
    position: absolute; left: -3dp; top: -3dp; right: -3dp; bottom: -3dp; border-radius: 10dp; opacity: 0; pointer-events: none;
    box-shadow: 0 0 0 1dp {ac-ring}, 0 0 24dp 6dp {ac-glow}e0, 0 0 8dp 2dp {ac-shine}, inset 0 0 14dp 0 {ac-edge}90;
}
.tr.sel .glow { opacity: 1; }
.td {
    height: 100%; display: flex; flex-direction: row; align-items: center; min-width: 0; overflow: hidden;
    font-family: Condensed; font-weight: 400; font-size: 24dp; line-height: 1; color: {g-text}; white-space: nowrap;
}
.td.c-game { padding: 0; }
/* the row is 66dp with a 2dp border (3dp selected): 56dp leaves the art clear of the border and of the rounded corners */
.thumb { flex: 0 0 56dp; width: 56dp; height: 56dp; margin: 0 0 0 6dp; border-radius: 4dp; overflow: hidden; }
.thumb .letter { width: 56dp; height: 56dp; line-height: 56dp; text-align: center; font-family: Inter; font-size: 26dp; font-weight: 700; color: #ffffffe0; }
.thumb.broken { text-align: center; line-height: 56dp; background-color: #4a2f31; color: #ff8a80; }
.thumb.broken .ic { font-size: 24dp; line-height: 56dp; }
.names { flex: 1 1 0; min-width: 0; margin-left: 13dp; }
.title { font-size: 28.8dp; }
.sub { font-size: 14dp; color: {g-text-2}; }
.tr.broken .title { color: {g-text-2}; }
/* the selected row is the accent's green under light text, in both themes */
.tr.sel .td { color: {sel-text}; }
.tr.sel .sub { color: {sel-sub}; }
.td.c-status { font-size: 20dp; }
.td .dot { flex: 0 0 12dp; width: 12dp; height: 12dp; border-radius: 6dp; margin-right: 11dp; }
.td .dot.prep { background-color: {dot-prep}; }
.td .dot.ready { background-color: {dot-ready}; }
.td .dot.interp, .td .dot.bad { background-color: {dot-bad}; }
.td .dot.run { background-color: {dot-run}; }
.tr.sel .td .dot.prep { background-color: {sel-dot-prep}; }
.tr.sel .td .dot.ready { background-color: {sel-dot-ready}; }
.tr.sel .td .dot.interp, .tr.sel .td .dot.bad { background-color: {sel-dot-bad}; }
.tr.sel .td .dot.run { background-color: {sel-dot-run}; }
.td.c-opts { justify-content: center; }
.opt-btn {
    width: 30dp; height: 30dp; line-height: 27dp; text-align: center; border: 1.5dp {opt-border}; border-radius: 6dp;
    decorator: linear-gradient(180deg, {opt-0} 0%, {opt-1} 38%, {opt-2} 58%, {opt-3} 100%);
    box-shadow: 0 0 0 1dp {opt-ring}, 0 2dp 3dp 1dp {btn-drop}, inset 0 1dp 1dp 0 {opt-inset};
    color: {btn-text}; cursor: pointer;
}
.opt-btn .cog { font-size: 19dp; line-height: 27dp; }
.opt-btn:hover { border-color: {opt-h-border}; decorator: linear-gradient(180deg, {opt-h0} 0%, {opt-h1} 38%, {opt-h2} 58%, {opt-h3} 100%); }
.opt-btn:active { decorator: linear-gradient(180deg, {opt-p0} 0%, {opt-p1} 60%, {opt-p2} 100%); box-shadow: 0 0 0 1dp {opt-p-ring}, inset 0 1dp 3dp 0 {btn-p-inset}; }

#tempty { position: absolute; left: 0; top: 38dp; width: 100%; bottom: 0; display: none; padding: 0 8.8%; }
#table.has-games #tempty { top: 90dp; }
#tempty.on { display: flex; flex-direction: column; align-items: center; justify-content: center; }
.empty { display: flex; flex-direction: column; align-items: center; width: 460dp; }
.empty .big-ic { font-family: Lucide; font-size: 46dp; line-height: 1; color: #d6d5da; margin-bottom: 14dp; }
.empty-title { font-size: 20dp; font-weight: 300; color: #ffffff; margin-bottom: 6dp; }
.empty-text { color: #ecebef; text-align: center; }
.empty-buttons { display: flex; flex-direction: row; margin-top: 16dp; }
/* the buttons wear the game rows' look: the primary one the selected row's green glow, the others the plain row */
.empty-buttons .btn {
    height: 50dp; min-width: 190dp; margin: 0 8dp; padding: 0 26dp; border: 2dp {row-border}; border-radius: 9dp;
    font-family: Condensed; font-weight: 400; font-size: 24dp; line-height: 1; color: {g-text};
    decorator: radial-gradient(ellipse 17% 125% at 25.7% 0%, {row-shine}, #ffffff00),
               radial-gradient(ellipse 17% 125% at 75.4% 0%, {row-shine}, #ffffff00),
               linear-gradient(180deg, {row-0o}, {row-3o});
    background-color: transparent;
    box-shadow: 0 0 0 1dp {row-ring}, 0 3dp 6dp 1dp {row-drop}, inset 0 1dp 0 0 {row-inset};
}
.empty-buttons .btn .ic { font-size: 22dp; margin-right: 10dp; color: {g-text}; }
.empty-buttons .btn:hover {
    border-color: {row-border-h}; background-color: transparent;
    decorator: radial-gradient(ellipse 17% 125% at 25.7% 0%, {row-shine-h}, #ffffff00),
               radial-gradient(ellipse 17% 125% at 75.4% 0%, {row-shine-h}, #ffffff00),
               linear-gradient(180deg, {row-h0o}, {row-h3o});
}
.empty-buttons .btn.primary, .empty-buttons .btn.primary:hover, .empty-buttons .btn.primary:active {
    border: 2dp {ac-shine}; border-radius: 10dp; border-color: {ac-shine}; background-color: transparent; font-weight: 400; color: {sel-text};
    decorator: radial-gradient(ellipse 17% 125% at 25.7% 0%, #ffffff4a, #ffffff00),
               radial-gradient(ellipse 17% 125% at 75.4% 0%, #ffffff4a, #ffffff00),
               linear-gradient(180deg, {ac-top}e0 0%, {ac-mid}e0 55%, {ac-low}e0 95%, {ac-end}e0 100%);
    box-shadow: 0 0 0 1dp {ac-ring}, 0 0 24dp 6dp {ac-glow}e0, 0 0 10dp 2dp {ac-shine}80, inset 0 0 5dp 1dp {ac-pale}c0, inset 0 0 16dp 2dp {ac-edge}70;
}
.empty-buttons .btn.primary .ic { color: {sel-text}; }
.empty-buttons .btn.primary:active {
    decorator: linear-gradient(180deg, {ac-end} 0%, {ac-low} 45%, {ac-mid} 100%);
}

/* ------------------------------------------------------------------- hints */

#hints, #shints { flex: 0 0 auto; height: 44dp; display: flex; flex-direction: row; align-items: center; padding: 0 31dp 0 41dp; }
.pad-hints { display: flex; flex-direction: row; align-items: center; flex: 1 1 0; }
.gl { width: 38dp; height: 38dp; flex: 0 0 auto; }
.gl.a { decorator: image(mem:pad-a contain); }
.gl.b { decorator: image(mem:pad-b contain); }
.gl.x { decorator: image(mem:pad-x contain); }
.gl.y { decorator: image(mem:pad-y contain); }
.gl.lb { decorator: image(mem:pad-lb contain); margin-right: -6dp; }
.gl.rb { decorator: image(mem:pad-rb contain); }
.gl.lt { decorator: image(mem:pad-lt contain); margin-right: -6dp; }
.gl.rt { decorator: image(mem:pad-rt contain); }
.gl.back { decorator: image(mem:pad-back contain); }
.gl.start { decorator: image(mem:pad-start contain); }
.hint { display: flex; flex: 0 0 auto; flex-direction: row; align-items: center; margin-right: 24dp; }
.hl { margin-left: 8dp; font-family: Condensed; font-weight: 400; font-size: 15dp; line-height: 1; color: #ffffff; white-space: nowrap; filter: drop-shadow(#000000b0 0dp 1dp 1.5dp); }
.key-hints { display: flex; flex-direction: row; align-items: center; flex: 0 0 auto; }
.key-hints .ic { font-size: 24dp; color: #ffffff; filter: drop-shadow(#000000b0 0dp 1dp 1.5dp); }
.hint-dot { width: 3dp; height: 3dp; border-radius: 2dp; margin: 8dp 6dp 0 6dp; background-color: #ffffff; }
.keycap {
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    height: 25dp; margin-left: 12dp; padding: 0 6dp; border: 1dp {key-border}; border-radius: 5dp;
    decorator: linear-gradient(180deg, {key-0}, {key-1}); color: {key-text}; font-family: Condensed; font-size: 13.5dp; line-height: 1;
}
.key-hints .hl { margin-right: 0; }
.key-hints .hl.gap { margin-right: 0; }
.keycap.one { min-width: 37dp; }
.keycap.two { min-width: 40dp; font-size: 11dp; line-height: 0.95; }

/* -------------------------------------------------------------- status bar */

#statusbar {
    flex: 0 0 auto; height: 17dp; display: flex; flex-direction: row; align-items: center;
    padding: 0 6dp; background-color: {sb-bg}; border-top: 1dp {sb-top};
    color: {sb-text}; font-size: 10dp; font-weight: 300;
}
.st { padding: 0 8dp; white-space: nowrap; }
.st-sep { flex: 0 0 1dp; width: 1dp; height: 12dp; background-color: {sb-sep}; }
#st-folder { flex: 1 1 0; min-width: 0; overflow: hidden; text-overflow: ellipsis; cursor: pointer; }
#st-folder:hover { color: {g-on}; }
#st-message { flex: 0 1 auto; min-width: 0; overflow: hidden; text-overflow: ellipsis; display: flex; flex-direction: row; align-items: center; }
#st-message.err { color: {g-bad}; }
#st-message.ok { color: {sb-ok}; }
.st-link { color: {g-link}; cursor: pointer; margin-left: 8dp; }
.st-link:hover { text-decoration: underline; }
#st-progress { display: none; flex-direction: row; align-items: center; cursor: pointer; }
#st-progress.on { display: flex; }
.minibar { width: 110dp; height: 6dp; margin-left: 8dp; border-radius: 3dp; background-color: {sb-sep}; }
.minibar-fill { height: 6dp; border-radius: 3dp; background-color: {accent}; }
#st-message .st-ic { font-size: 12dp; margin-right: 6dp; color: {dot-ready}; }

/* ---------------------------------------------------------- prepare dialog */

.prep-head { display: flex; flex-direction: row; align-items: center; margin-bottom: 16dp; }
.prep-icon { flex: 0 0 48dp; width: 48dp; height: 48dp; border-radius: 6dp; margin-right: 14dp; }
.prep-icon .letter { width: 48dp; height: 48dp; line-height: 48dp; text-align: center; font-size: 20dp; font-weight: 700; color: #ffffffe0; }
.prep-title { font-size: 15dp; font-weight: 600; }
.prep-state { display: flex; flex-direction: row; align-items: center; margin-top: 3dp; }
.stages { cursor: progress; display: flex; flex-direction: row; margin-bottom: 14dp; }
.stage { flex: 1 1 0; margin-right: 6dp; }
.stage .bar { height: 4dp; border-radius: 2dp; background-color: {border}; }
.stage .in { height: 4dp; border-radius: 2dp; background-color: {accent}; width: 0%; }
.stage .nm { margin-top: 5dp; font-size: 11.5dp; color: {text-3}; }
.stage.now .nm { color: {text}; font-weight: 500; }
.stage.done .nm { color: {text-2}; }
.stage.bad .in { background-color: {bad}; }
.stage.bad .nm { color: {bad}; }
.pbar { cursor: progress; height: 8dp; border-radius: 4dp; background-color: {border}; }
.pfill { height: 8dp; border-radius: 4dp; background-color: {accent}; width: 0%; }
.pbar.failed .pfill { background-color: {bad}; }
.pbar.done .pfill { background-color: {good}; }
.prep-meta { display: flex; flex-direction: row; align-items: center; margin-top: 8dp; }
#prep-count b { font-weight: 600; }
.prep-file { margin-top: 3dp; height: 18dp; font-size: 12dp; color: {text-3}; }
.errbox { display: none; margin-top: 10dp; padding: 10dp 12dp; border-radius: 4dp; border: 1dp {bad}; color: {text}; }
.errbox.on { display: block; }
.log-toggle { display: flex; flex-direction: row; align-items: center; margin-top: 12dp; color: {link}; cursor: pointer; }
.log-toggle .chev { font-size: 13dp; margin-right: 4dp; }
.log-toggle.open .chev { transform: rotate(180deg); }
.log {
    display: none; margin-top: 8dp; height: 180dp; padding: 8dp 10dp; overflow-y: auto;
    border: 1dp {border}; border-radius: 4dp; background-color: {input}; font-size: 12dp; color: {text-2};
}
.log.open { display: block; }
.log .l { white-space: nowrap; }
.log .l.head { color: {text}; }
.log .l.err { color: {bad}; }

/* ------------------------------------------------------------ about dialog */

.about-head { display: flex; flex-direction: row; align-items: center; margin-bottom: 12dp; }
.mark {
    width: 38dp; height: 38dp; border-radius: 9dp; margin: 0 16dp 0 4dp; transform: rotate(45deg);
    decorator: linear-gradient(135deg, {accent-hi}, {accent-lo});
}
.mark-core { position: absolute; left: 12dp; top: 12dp; width: 14dp; height: 14dp; border-radius: 3dp; background-color: {dialog}; }
.about-name { font-size: 18dp; font-weight: 700; }
.about-ver { color: {text-2}; font-size: 12dp; }
.about-text { margin-bottom: 10dp; }
.about-note { padding: 9dp 11dp; border-radius: 4dp; background-color: {hover}; color: {text-2}; font-size: 12dp; }
.about-licenses { margin: 16dp 0 4dp 0; font-weight: 600; }
.lic { padding: 8dp 0; border-bottom: 1dp {border}; }
.lic-top { display: flex; flex-direction: row; align-items: center; }
.lic-name { font-weight: 500; flex: 1 1 0; }
.lic-tag { font-size: 11.5dp; color: {text-2}; padding: 1dp 7dp; border: 1dp {border-strong}; border-radius: 9dp; }
.lic-text { margin-top: 3dp; color: {text-2}; font-size: 12dp; }
.about-foot { margin-top: 12dp; font-size: 12dp; }
.msg { max-width: 100%; }
/* ------------------------------------------- menus and dialogs, the console's way
   (the typeface, the selected item as the selected row, the main button as the toolbar's glossy accent) */

.menu { border-radius: 8dp; padding: 5dp; }
.mi { height: 31dp; border-radius: 5dp; font-family: Condensed; font-size: 18dp; font-weight: 400; }
.mi-ic { font-size: 15dp; }
.mi-k { font-size: 14dp; }
.mi:hover, .mi.hot {
    color: {sel-text}; decorator: linear-gradient(180deg, {ac-top} 0%, {ac-mid} 55%, {ac-low} 100%);
    box-shadow: inset 0 1dp 0 0 #ffffff40, 0 0 8dp 0 {ac-glow}90;
}
.mi:hover .mi-ic, .mi.hot .mi-ic, .mi:hover .mi-k, .mi.hot .mi-k { color: {sel-text}d0; }
.mi.off:hover { color: {text-3}; decorator: none; box-shadow: none; }

/* the modal: a grey header under white text, the content white under #4f5655 text (inverted in the dark
   theme), the main button a flat green, and under the block, as wide as it, the pad's hints */
.dlg-wrap { display: flex; flex-direction: column; max-height: 92vh; animation: dialog-in 0.22s cubic-out; }
.dialog {
    flex: 0 1 auto; min-height: 0; max-height: 80vh; width: 100%; overflow: hidden;
    background-color: {dlg-bg}; color: {dlg-text}; border: 1dp {dlg-border}; border-radius: 8dp; animation: none;
}
.dlg-title {
    height: 44dp; color: #ffffff; font-family: Condensed; font-size: 21dp; font-weight: 400; border-bottom: 0;
    decorator: linear-gradient(180deg, #889193, #4e5454);
}
.dlg-x { color: #ffffffd0; }
.dlg-x:hover { background-color: #ffffff30; color: #ffffff; }
.dlg-body { color: {dlg-text}; }
.dlg-foot { background-color: transparent; border-top: 1dp {dlg-line}; border-radius: 0; }
.dlg-hints { flex: 0 0 auto; display: flex; flex-direction: row; align-items: center; height: 44dp; padding: 0 2dp; }
.dlg-hints .hint { margin-right: 24dp; }
.dlg-foot .btn { height: 31dp; border-radius: 6dp; font-family: Condensed; font-size: 18dp; font-weight: 400; background-color: {dlg-btn}; color: {dlg-text}; border-color: {dlg-btn-border}; }
.dlg-foot .btn:hover { background-color: {dlg-btn-h}; }
.dlg-foot .btn .ic { color: {dlg-text-2}; }
/* what the dialogs' bodies draw, in the content's colours */
.about-ver, .lic-text, .lic-tag { color: {dlg-text-2}; }
.about-note { background-color: {dlg-soft}; color: {dlg-text-2}; }
.lic { border-bottom: 1dp {dlg-line}; }
.lic-tag { border-color: {dlg-btn-border}; }
.mark-core { background-color: {dlg-bg}; }
.stage .bar, .pbar { background-color: {dlg-line}; }
.stage .nm, .prep-file { color: {dlg-text-3}; }
.stage.now .nm, .errbox, .log .l.head { color: {dlg-text}; }
.stage.done .nm, .log { color: {dlg-text-2}; }
.log { border-color: {dlg-line}; background-color: {dlg-soft}; }
.dlg-foot .btn.primary, .dlg-foot .btn.primary:hover {
    color: #ffffff; border: 1dp #008001; background-color: #008001; font-weight: 500;
}
.dlg-foot .btn.primary:hover { background-color: #0a940b; border-color: #0a940b; }
.dlg-foot .btn.primary:active { background-color: #006a01; border-color: #006a01; }
.dlg-foot .btn.primary:focus-visible { border-color: #7be07c; box-shadow: 0 0 0 3dp #00800170; }
.dlg-foot .btn.primary .ic { color: #ffffff; }

/* nothing to list: no column heads over the empty state */
#table.no-rows #thead { visibility: hidden; }

/* the menus' layer starts below the header, so its sections stay live while a menu is open */
#menu-layer { top: 74dp; height: auto; bottom: 0; }
/* the open menu itself, placed in the window's coordinates from this corner (as wide as the window, so a menu is as wide as its items) */
#menu-host { position: absolute; left: 0; top: 0; width: 100%; height: 0; }
