<rml>
<head>
    <title>XenoForge</title>
    <!--STYLE-->
</head>
<body>
    <div id="app">
        <div id="header">
            <div id="brand">xeno<span>forge</span></div>
            <div id="nav">
                <div class="nav f on" id="nav-games">games</div>
                <div class="nav f" id="menu-emulation" data-menu="emulation">emulation</div>
                <div class="nav f" id="nav-settings" data-action="settings">settings</div>
                <div class="nav f" id="menu-help" data-menu="help">help</div>
            </div>
            <div id="search-box">{i:search}<input type="text" class="text f" id="search" placeholder="Search games"/><div id="search-clear" data-action="clear-search">{i:x}</div></div>
        </div>
        <div id="toolbar">
            <div class="tb primary f" id="tb-play" data-action="play">{i:play}<div id="tb-play-label">Play</div></div>
            <div class="tb f" id="tb-prepare" data-action="prepare">{i:hammer}<div id="tb-prepare-label">Prepare</div></div>
            <div class="tb f" id="tb-browse" data-action="browse">{i:folder-open}<div>Open Folder</div></div>
            <div class="tb f" id="tb-rescan" data-action="rescan">{i:refresh-cw}<div>Rescan</div></div>
            <div class="tb f" id="tb-settings" data-action="settings">{i:settings}<div>Settings</div></div>
            <div class="tb f" id="tb-controls" data-action="controls">{i:gamepad-2}<div>Controls</div></div>
            <div class="tb f" id="tb-demo" style="display: none;" data-action="demo-games">{i:layers}<div>Demo games</div></div>
        </div>
        <div id="table">
            <div id="thead"></div>
            <div id="tbody"></div>
            <div id="tempty"></div>
        </div>
        <div id="hints">
            <div class="pad-hints">
                <div class="hint"><div class="pb a">A</div><div class="hl">Play</div></div>
                <div class="hint" id="hint-b" style="display: none;"><div class="pb b">B</div><div class="hl">Clear search</div></div>
                <div class="hint"><div class="pb x">X</div><div class="hl">Settings</div></div>
                <div class="hint"><div class="pb y">Y</div><div class="hl">Rescan</div></div>
            </div>
            <div class="key-hints">
                {i:keyboard}<div class="hint-dot"></div>{i:mouse}
                <div class="keycap one"><div>Enter</div></div><div class="hl">Play</div>
                <div class="keycap two"><div>Page</div><div>Up</div></div>
                <div class="keycap two"><div>Page</div><div>Down</div></div><div class="hl">Scroll</div>
            </div>
        </div>
        <div id="statusbar">
            <div class="st" id="st-count"></div>
            <div class="st-sep"></div>
            <div class="st" id="st-folder" data-action="browse"></div>
            <div class="st" id="st-message"></div>
            <div class="st" id="st-progress" data-action="show-prepare"></div>
            <div class="st-sep"></div>
            <div class="st" id="st-version">XenoForge pre-release</div>
        </div>
    </div>
    <div id="menu-layer"></div>
    <div id="menu-host"></div>
    <div id="dialog-layer"></div>
</body>
</rml>
