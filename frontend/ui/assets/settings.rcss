/*
 * XenoForge launcher, the settings page: the second page of the main window's
 * strip (launcher.rml's #spage), beside the library. Like the library it wears
 * the console's look, fixed (it does not follow the light or dark theme): the tabs are the
 * toolbar's glossy buttons, the settings are rows like the games' with the
 * focused one in Xbox green, the controls are dark slots let into them. Every
 * rule is under #spage, because the page shares the window's stylesheet.
 * launcher.rcss comes before this file.
 */

/* the tabs are the toolbar's buttons (launcher.rcss: #tabs, .tab), whose whole
   page is under it: whose settings these are, then the rows */

#scope { flex: 0 0 auto; padding: 10dp 8.8% 0 8.8%; }
#scope .scope-text { padding: 4dp 8dp 0 8dp; }
#scope .scope-text .name { font-family: Condensed; font-size: 22dp; color: #ffffff; }
#scope .scope-text .hint { display: block; margin: 0; font-family: Condensed; font-size: 15dp; color: #e0dfe4; }

#pages { flex: 1 1 0; min-height: 0; padding: 4dp 8.8% 18dp 8.8%; overflow-y: auto; overflow-x: hidden; }
#pages .page { position: relative; } /* (left: a tab's page comes in from the side, SettingsView::slide_page_in) */
#pages .group { margin-top: 14dp; }
#pages .group-title {
    margin-bottom: 8dp; padding: 0 0 5dp 4dp; border-bottom: 1dp #ffffff50;
    font-family: Condensed; font-size: 19.5dp; line-height: 1; color: #ffffff; text-transform: uppercase;
}
#pages .group-note { margin: 2dp 0 0 8dp; font-family: Condensed; font-size: 15dp; color: #e0dfe4; }

/* a row: the games' rows, shorter; the one with focus is the selected row's green */
#spage .setting, #spage .bind {
    display: flex; flex-direction: row; align-items: center; min-height: 50dp; margin-bottom: 6dp; padding: 6dp 14dp;
    border: 2dp #666668; border-radius: 9dp; cursor: default;
    decorator: radial-gradient(ellipse 17% 125% at 25.7% 0%, #ffffff30, #ffffff00),
               radial-gradient(ellipse 17% 125% at 75.4% 0%, #ffffff30, #ffffff00),
               linear-gradient(180deg, #2c2c2eb8 0%, #2d2d2fb8 55%, #2e2e30b8 95%, #2f2f31b8 100%);
    box-shadow: 0 0 0 1dp #1c1c1d, 0 3dp 6dp 1dp #00000080, inset 0 1dp 0 0 #ffffff1a;
    transition: decorator 0.18s cubic-out, border-color 0.18s cubic-out;
}
#spage .setting:hover, #spage .bind:hover {
    border-color: #77777a;
    decorator: radial-gradient(ellipse 17% 125% at 25.7% 0%, #ffffff34, #ffffff00),
               radial-gradient(ellipse 17% 125% at 75.4% 0%, #ffffff34, #ffffff00),
               linear-gradient(180deg, #343436c0 0%, #353537c0 55%, #363638c0 95%, #373739c0 100%);
}
#spage .setting:focus-visible, #spage .bind:focus-visible, #spage .bind.capturing {
    border-color: #c9ffc2;
    decorator: radial-gradient(ellipse 17% 125% at 25.7% 0%, #ffffff4a, #ffffff00),
               radial-gradient(ellipse 17% 125% at 75.4% 0%, #ffffff4a, #ffffff00),
               linear-gradient(180deg, #55a928e0 0%, #52a326e0 55%, #458536e0 95%, #3f7d32e0 100%);
    box-shadow: 0 0 0 1dp #2c7a1a, 0 0 14dp 3dp #6dff3ad0, inset 0 0 12dp 0 #c8ffb080;
}
#spage .check-row, #spage .setting[data-action], #spage .bind { cursor: pointer; }

#spage .setting .label { flex: 1 1 0; min-width: 0; margin-right: 16dp; }
#spage .setting .name { font-family: Condensed; font-size: 22dp; line-height: 1.15; color: #f6f6f6; }
#spage .setting .hint { display: block; margin: 1dp 0 0 0; font-family: Condensed; font-size: 15dp; line-height: 1.15; color: #c8c8cc; }
#spage .setting:focus-visible .hint { color: #e8ffe0; }
#spage .setting .control { flex: 0 0 auto; display: flex; flex-direction: row; align-items: center; }

/* a check box, its label beside it */
#spage .check {
    flex: 0 0 26dp; width: 26dp; height: 26dp; margin: 0 14dp 0 0; text-align: center;
    border: 2dp #8d8c92; border-radius: 6dp;
    decorator: linear-gradient(180deg, #151517, #282829);
    box-shadow: inset 0 2dp 4dp 0 #000000a0;
}
#spage .check .ic { margin: 0; font-size: 17dp; line-height: 22dp; color: #ffffff; visibility: hidden; }
#spage .check.on {
    border-color: #c9ffc2; decorator: linear-gradient(180deg, #62b834, #458536);
    box-shadow: 0 0 0 1dp #2c7a1a, 0 0 8dp 1dp #6dff3a90, inset 0 1dp 1dp 0 #ffffff40;
}
#spage .check.on .ic { visibility: visible; }

/* a slider and its value */
#spage .slider { position: relative; width: 260dp; height: 26dp; cursor: pointer; }
#spage .slider .track {
    position: absolute; left: 0; top: 8dp; width: 100%; height: 10dp; border: 1dp #3c3c3f; border-radius: 5dp;
    decorator: linear-gradient(180deg, #151517, #28282a); box-shadow: 0 1dp 0 0 #ffffff30;
}
#spage .slider .fill {
    position: absolute; left: 0; top: 9dp; height: 8dp; border-radius: 4dp;
    decorator: linear-gradient(180deg, #62b834, #458536); /* no shadow: the fill is often 0 wide, and a shadow of nothing asserts */
}
#spage .slider .thumb {
    position: absolute; top: 3dp; width: 20dp; height: 20dp; margin-left: -10dp; border: 1.5dp #d4d3d8; border-radius: 10dp;
    decorator: linear-gradient(180deg, #9a9999 0%, #6d6c6c 48%, #565555 52%, #747373 100%);
    box-shadow: 0 1dp 3dp 0 #00000090;
}
#spage .slider:hover .thumb { border-color: #ffffff; }
#spage .setting .value { width: 58dp; text-align: right; font-family: Condensed; font-size: 21dp; color: #f6f6f6; }

/* a dropdown: the search bar's let-in slot */
#spage .select {
    display: flex; flex-direction: row; align-items: center; width: 290dp; height: 34dp; padding: 0 10dp 0 14dp;
    border: 2dp #3c3c3f; border-radius: 9dp; cursor: pointer;
    decorator: linear-gradient(180deg, #161618d8, #232325d0);
    box-shadow: 0 1dp 0 0 #ffffff38, inset 0 2dp 6dp 0 #000000a0;
    font-family: Condensed; font-size: 20dp; color: #f6f6f6;
    transition: border-color 0.16s cubic-out;
}
#spage .select .value-text { flex: 1 1 0; }
#spage .select .chev { margin: 0; font-size: 16dp; color: #c4c3c9; }
#spage .select:hover { border-color: #55555a; }
#spage .select.open { border-color: #c9ffc2; }
#popup .mi { padding-left: 10dp; }
#popup .mi.current { font-weight: 500; }

/* the accent's swatches */
#spage .swatches { padding-right: 2dp; }
#spage .swatch { width: 24dp; height: 24dp; margin-left: 10dp; border: 2dp #ffffff50; border-radius: 12dp; cursor: pointer; }
#spage .swatch:hover { border-color: #ffffffb0; }
#spage .swatch.on { border-color: #ffffff; box-shadow: 0 0 0 2dp #ffffff50; }
#spage .swatch:focus-visible { border-color: #ffffff; box-shadow: 0 0 0 3dp #ffffff; }

/* the games folder */
#spage .folder-row { display: flex; flex-direction: row; align-items: center; margin: 0 0 6dp 0; padding: 0 2dp; }
#spage input.text {
    flex: 1 1 0; width: 100dp; height: 36dp; margin-right: 6dp; padding: 0 12dp; line-height: 32dp;
    border: 2dp #3c3c3f; border-radius: 9dp; cursor: text;
    decorator: linear-gradient(180deg, #161618d8, #232325d0);
    box-shadow: 0 1dp 0 0 #ffffff38, inset 0 2dp 6dp 0 #000000a0;
    font-family: Condensed; font-size: 20dp; color: #f6f6f6;
}
#spage input.text:hover { border-color: #55555a; }
#spage input.text:focus { border-color: #c9ffc2; }
#spage input.text:placeholder-shown { color: #8d8c92; }

/* the buttons: the toolbar's */
#spage .btn {
    height: 34dp; min-width: 0; margin-left: 6dp; padding: 0 14dp 0 12dp; border: 1.5dp #7c7b79; border-radius: 6dp;
    decorator: linear-gradient(180deg, #62615f 0%, #504f4e 40%, #444342 62%, #504f4e 100%);
    background-color: transparent;
    box-shadow: 0 0 0 1dp #2b2b2a, 0 2dp 3dp 1dp #00000050, inset 0 1dp 1dp 0 #ffffff26;
    font-family: Condensed; font-size: 19dp; font-weight: 400; color: #f4f4f4;
}
#spage .btn .ic { margin-right: 7dp; font-size: 18dp; color: #f4f4f4; }
#spage .btn:hover { border-color: #918f8d; background-color: transparent; decorator: linear-gradient(180deg, #727170 0%, #5e5d5c 40%, #504f4e 62%, #5c5b5a 100%); }
#spage .btn:active { background-color: transparent; decorator: linear-gradient(180deg, #424140 0%, #4c4b4a 60%, #565554 100%); }
#spage .btn:focus-visible { border-color: #ffffff; box-shadow: 0 0 0 1dp #2b2b2a, 0 0 10dp 2dp #ffffffa0; }
#pages .page-buttons { display: flex; flex-direction: row; margin: 14dp 0 0 0; }
#pages .page-buttons .btn { margin-left: 0; }

/* the gamepads connected */
#spage .pads { padding: 4dp 8dp; }
#spage .gamepad { display: flex; flex-direction: row; align-items: center; height: 32dp; font-family: Condensed; font-size: 20dp; color: #f6f6f6; }
#spage .gamepad .dot { flex: 0 0 12dp; width: 12dp; height: 12dp; border-radius: 6dp; margin-right: 11dp; }
#spage .gamepad .dot.ready { background-color: #8bdc55; }
#spage .gamepad .dot.off { background-color: #8d8c92; }
#spage .pad-user { width: 84dp; }
#spage .dim { color: #c8c8cc; }

/* the keyboard's bindings */
#spage .bind { height: 46dp; min-height: 46dp; padding: 0 14dp; }
#spage .bname { width: 230dp; font-family: Condensed; font-size: 21dp; color: #f6f6f6; }
#spage .keys { flex: 1 1 0; display: flex; flex-direction: row; align-items: center; }
#pages .keycap {
    display: block; height: 28dp; margin: 0 6dp 0 0; padding: 0 10dp; line-height: 24dp;
    border: 1dp #777677; border-bottom-width: 2dp; border-radius: 5dp;
    decorator: linear-gradient(180deg, #3b3a3b, #232223);
    font-family: Condensed; font-size: 17dp; color: #ffffff;
}
#pages .keycap.mod { color: #c8c8cc; }
#pages .keycap.press { border-color: #c9ffc2; color: #ffffff; }
#spage .bset { font-family: Condensed; font-size: 16dp; color: #e8ffe0; visibility: hidden; }
#spage .bind:hover .bset, #spage .bind:focus-visible .bset { visibility: visible; }

/* the hints at the foot: the note between the pad's and the keyboard's */
/* (the buttons keep their size; the note takes what is left and is cut short, then gone, as the window narrows) */
#shints .pad-hints { flex: 0 0 auto; }
#shints .note { flex: 1 1 0; min-width: 0; overflow: hidden; white-space: nowrap; text-align: center; font-family: Condensed; font-size: 15dp; color: #2e2d30; }
