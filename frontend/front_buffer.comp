#version 450
// A front buffer made the window's picture on the GPU (presenter.cpp), at the
// swap, as the renderer's read-back makes it on the CPU (renderer.cpp,
// deliver; Xenia's presenter): the fetch constant's swizzle, opaque, each
// component in the front buffer's bits (8, or 10 for 2_10_10_10) through the
// display's look-up table as DC_LUTA_CONTROL sets it (renderer.h's
// display_gamma: the 256-entry ramp, 10 bits a component, red highest, or
// the piecewise linear one of 128 entries a component), the 10 bits given
// back to 8.

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D front;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D picture;
layout(set = 0, binding = 2, std140) uniform Ramp {
    uvec4 ramp[160]; // word i at ramp[i / 4][i % 4]: the table's 256, then the ramp's 128 x 3
};

uint word(uint i) { return ramp[i >> 2u][i & 3u]; }

layout(push_constant) uniform Push {
    uvec2 size;
    uint swizzle;    // 3 bits a component: 0-3 the texel's, 4 zero, 5 one
    uint components; // the front buffer's host format's
    uint bits;       // the front buffer's bits a component: 8 or 10
    uint luta;       // DC_LUTA_CONTROL
} pc;

void main() {
    uvec2 at = gl_GlobalInvocationID.xy;
    if (any(greaterThanEqual(at, pc.size))) return;
    vec4 texel = texelFetch(front, ivec2(at), 0);
    uvec3 v;
    for (int c = 0; c < 3; c++) {
        uint guest = (pc.swizzle >> (3 * c)) & 7u;
        float value = guest == 5u ? 1.0 : guest >= 4u ? 0.0 : texel[min(guest, pc.components - 1u)];
        v[c] = uint(clamp(value, 0.0, 1.0) * float((1u << pc.bits) - 1u) + 0.5);
    }
    for (int c = 0; c < 3; c++) {
        uint increment = pc.luta & 0xFu; // the blue field's, for all (renderer.h's display_gamma)
        uint ten;
        if (increment == 0u) {
            uint entry = word((v[c] >> (pc.bits - 8u)) & 0xFFu);
            ten = (entry >> (c == 0 ? 20 : c == 1 ? 10 : 0)) & 0x3FFu;
        } else {
            increment = min(increment, 9u);
            uint entry = word(256u + ((v[c] >> increment) & 0x7Fu) * 3u + uint(c));
            float out_value = (float(entry & 0xFFFFu) + float((v[c] & ((1u << increment) - 1u)) * (entry >> 16u)) /
                                                        float(1u << increment)) * (1.0 / (64.0 * 1023.0));
            ten = uint(clamp(out_value, 0.0, 1.0) * 1023.0 + 0.5);
        }
        v[c] = pc.bits == 10u ? uint(float(ten) * (255.0 / 1023.0) + 0.5) : (ten * 255u + 511u) / 1023u;
    }
    imageStore(picture, ivec2(at), vec4(vec3(v) / 255.0, 1.0));
}
