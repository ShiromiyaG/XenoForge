#version 450
#extension GL_GOOGLE_include_directive : require
// The window's picture effects (presenter.cpp), as Xenia's presenter offers
// them (src/xenia/ui/shaders/guest_output_ffx_fsr_easu.ps.xesl,
// guest_output_ffx_fsr_rcas.xesli, guest_output_ffx_cas_resample.xesli and
// guest_output_ffx_cas_sharpen.xesli; src/xenia/gpu/shaders/fxaa.hlsli), as
// compute shaders writing an RGBA8 image. BSD; see LICENSE-xenia. The
// effects themselves are AMD's FidelityFX FSR 1 and CAS (MIT, their notices in
// third_party/FidelityFX-*) and NVIDIA's FXAA 3.11 (BSD, third_party/fxaa).
//
// One of, by define: EASU (FSR's upscale), RCAS (FSR's sharpening, at the
// same size), CAS (sharpening, resampling when the sizes differ), FXAA or
// FXAA_EXTREME (Xenia's two presets); the output resampling (AREA, BICUBIC,
// SHARP_BILINEAR; standard filters, Dolphin's "output resampling" choices);
// SMAA 1x's three passes (SMAA_EDGES, SMAA_WEIGHTS_<preset>, SMAA_BLEND;
// Jimenez et al., MIT, third_party/smaa).

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D source; // linear, clamped
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D dest;
// SMAA's other inputs (linear, clamped): the area texture for the weights, the blending weights for the blending
layout(set = 0, binding = 2) uniform sampler2D aux;
layout(set = 0, binding = 3) uniform sampler2D search; // SMAA's search texture

layout(push_constant) uniform Push {
    uvec2 dest_size;
    vec2 source_size;
    vec2 dest_size_f;
    float sharpness; // RCAS: exp2(-reduction); CAS: CasSetup's -1/lerp(8, 5, sharpness)
    uint scaling;    // CAS: the sizes differ
    vec2 param;      // BICUBIC: the filter's B and C; SMAA_EDGES: the threshold in x
} pc;

#define A_GPU 1
#define A_GLSL 1

#ifdef EASU
#include "../third_party/FidelityFX-FSR/ffx_a.h"
#define FSR_EASU_F 1
AF4 FsrEasuRF(AF2 p) { return textureGather(source, p, 0); }
AF4 FsrEasuGF(AF2 p) { return textureGather(source, p, 1); }
AF4 FsrEasuBF(AF2 p) { return textureGather(source, p, 2); }
#include "../third_party/FidelityFX-FSR/ffx_fsr1.h"
void main() {
    uvec2 at = gl_GlobalInvocationID.xy;
    if (any(greaterThanEqual(at, pc.dest_size))) return;
    // FsrEasuCon, as Xenia's shader makes it from the size ratio
    vec2 ratio = pc.source_size / pc.dest_size_f, inv = 1.0 / pc.source_size;
    uvec4 c0 = uvec4(floatBitsToUint(ratio), floatBitsToUint(0.5 * ratio - 0.5));
    uvec4 c1 = floatBitsToUint(vec4(1.0, 1.0, 1.0, -1.0) * inv.xyxy);
    uvec4 c2 = floatBitsToUint(vec4(-1.0, 2.0, 1.0, 2.0) * inv.xyxy);
    uvec4 c3 = uvec4(floatBitsToUint(0.0), floatBitsToUint(4.0 * inv.y), 0u, 0u);
    vec3 color;
    FsrEasuF(color, at, c0, c1, c2, c3);
    imageStore(dest, ivec2(at), vec4(color, 1.0));
}
#endif

#ifdef RCAS
#include "../third_party/FidelityFX-FSR/ffx_a.h"
#define FSR_RCAS_F 1
AF4 FsrRcasLoadF(ASU2 p) { return AF4(texelFetch(source, p, 0).rgb, 1.0); }
void FsrRcasInputF(inout AF1 r, inout AF1 g, inout AF1 b) {}
#include "../third_party/FidelityFX-FSR/ffx_fsr1.h"
void main() {
    uvec2 at = gl_GlobalInvocationID.xy;
    if (any(greaterThanEqual(at, pc.dest_size))) return;
    uvec4 con = uvec4(floatBitsToUint(pc.sharpness), packHalf2x16(vec2(pc.sharpness)), 0u, 0u);
    vec3 color;
    FsrRcasF(color.r, color.g, color.b, at, con);
    imageStore(dest, ivec2(at), vec4(color, 1.0));
}
#endif

#ifdef CAS
#include "../third_party/FidelityFX-CAS/ffx_a.h"
AF3 CasLoad(ASU2 p) { return texelFetch(source, p, 0).rgb; }
// the linear conversion approximation the CAS presentation recommends (Xenia's)
void CasInput(inout AF1 r, inout AF1 g, inout AF1 b) { r *= r, g *= g, b *= b; }
#include "../third_party/FidelityFX-CAS/ffx_cas.h"
void main() {
    uvec2 at = gl_GlobalInvocationID.xy;
    if (any(greaterThanEqual(at, pc.dest_size))) return;
    vec2 ratio = pc.source_size / pc.dest_size_f;
    uvec4 c0 = uvec4(floatBitsToUint(ratio), floatBitsToUint(0.5 * ratio - 0.5));
    uvec4 c1 = uvec4(floatBitsToUint(pc.sharpness), packHalf2x16(vec2(pc.sharpness, 0.0)),
                     floatBitsToUint(8.0 * ratio.x), 0u);
    vec3 color;
    if (pc.scaling != 0u)
        CasFilter(color.r, color.g, color.b, at, c0, c1, false);
    else
        CasFilter(color.r, color.g, color.b, at, c0, c1, true);
    imageStore(dest, ivec2(at), vec4(sqrt(color), 1.0));
}
#endif

#if defined(FXAA) || defined(FXAA_EXTREME)
#ifdef FXAA_EXTREME
#define FXAA_QUALITY__PRESET 39
#define SUBPIX 1.0
#define EDGE_THRESHOLD 0.063
#define EDGE_THRESHOLD_MIN 0.0312
#else
#define FXAA_QUALITY__PRESET 12
#define SUBPIX 0.75
#define EDGE_THRESHOLD 0.166
#define EDGE_THRESHOLD_MIN 0.0833
#endif
#define FXAA_PC 1
#define FXAA_GLSL_130 1
// the picture's alpha is opaque, not luma: green stands for it (Xenia writes
// luma into alpha in its gamma pass instead)
#define FXAA_GREEN_AS_LUMA 1
#include "../third_party/fxaa/FXAA3_11.h"
void main() {
    uvec2 at = gl_GlobalInvocationID.xy;
    if (any(greaterThanEqual(at, pc.dest_size))) return;
    vec2 inv = 1.0 / pc.source_size;
    vec2 p = (vec2(at) + 0.5) * inv;
    vec4 color = FxaaPixelShader(p, vec4(vec2(at), vec2(at) + 1.0) * inv.xyxy, source, source, source, inv,
                                 vec4(-0.5, -0.5, 0.5, 0.5) * inv.xyxy, vec4(-2.0, -2.0, 2.0, 2.0) * inv.xyxy,
                                 vec4(8.0, 8.0, -4.0, -4.0) * inv.xyxy, SUBPIX, EDGE_THRESHOLD, EDGE_THRESHOLD_MIN,
                                 8.0, 0.125, 0.05, vec4(1.0, -1.0, 0.25, -0.25));
    imageStore(dest, ivec2(at), vec4(color.rgb, 1.0));
}
#endif

#ifdef AREA
// Area sampling: each destination pixel the average of the source texels its
// footprint covers, each weighted by the part of it covered (a box filter of
// the exact ratio along each axis). Downscaling by any ratio every source
// texel counts once, where a linear blit reads 2x2 texels a pixel and skips
// the rest above 2x (aliasing, detail lost); upscaling it is nearest with the
// texels on a boundary blended. In the picture's own (gamma) encoding, as the
// blit and the other filters.
void main() {
    uvec2 at = gl_GlobalInvocationID.xy;
    if (any(greaterThanEqual(at, pc.dest_size))) return;
    vec2 ratio = pc.source_size / pc.dest_size_f;
    vec2 lo = vec2(at) * ratio, hi = min(lo + ratio, pc.source_size);
    ivec2 first = ivec2(floor(lo)), last = min(ivec2(ceil(hi)) - 1, ivec2(pc.source_size) - 1);
    vec3 sum = vec3(0.0);
    float total = 0.0;
    for (int y = first.y; y <= last.y; y++) {
        float wy = min(hi.y, float(y + 1)) - max(lo.y, float(y));
        for (int x = first.x; x <= last.x; x++) {
            float w = wy * (min(hi.x, float(x + 1)) - max(lo.x, float(x)));
            sum += w * texelFetch(source, ivec2(x, y), 0).rgb;
            total += w;
        }
    }
    imageStore(dest, ivec2(at), vec4(sum / max(total, 1e-8), 1.0));
}
#endif

#ifdef BICUBIC
// The Mitchell-Netravali family of cubics by its B and C (B-spline 1, 0;
// Mitchell-Netravali 1/3, 1/3; Catmull-Rom 0, 1/2), on 4x4 texels upscaling.
// Downscaling, the kernel widens by the ratio (up to 4x; beyond that it
// aliases as a 4x one would) so that it filters instead of skipping texels.
// The weights are normalized, so a flat picture stays flat; Catmull-Rom's
// negative lobes are clamped to the range.
const int BICUBIC_TAPS = 16; // the widest kernel's texels along an axis (4 texels times 4)
float cubic(float x, float b, float c) {
    x = abs(x);
    if (x < 1.0)
        return ((12.0 - 9.0 * b - 6.0 * c) * x * x * x + (-18.0 + 12.0 * b + 6.0 * c) * x * x + (6.0 - 2.0 * b)) / 6.0;
    if (x < 2.0)
        return ((-b - 6.0 * c) * x * x * x + (6.0 * b + 30.0 * c) * x * x + (-12.0 * b - 48.0 * c) * x +
                (8.0 * b + 24.0 * c)) / 6.0;
    return 0.0;
}
void main() {
    uvec2 at = gl_GlobalInvocationID.xy;
    if (any(greaterThanEqual(at, pc.dest_size))) return;
    vec2 ratio = pc.source_size / pc.dest_size_f;
    vec2 widen = clamp(ratio, vec2(1.0), vec2(4.0));
    vec2 center = (vec2(at) + 0.5) * ratio; // in source texels
    // the texels whose centers lie within the kernel's reach of 2 * widen
    ivec2 first = ivec2(floor(center - 2.0 * widen - 0.5)) + 1;
    // (an open interval 4 * widen long holds at most ceil(4 * widen) texel centers)
    ivec2 count = min(ivec2(ceil(4.0 * widen)), ivec2(BICUBIC_TAPS));
    // (the weights along x computed again for each row: cheaper than an array indexed at run time, which the
    // compilers keep in memory)
    ivec2 edge = ivec2(pc.source_size) - 1;
    vec3 sum = vec3(0.0);
    float total = 0.0;
    for (int j = 0; j < count.y; j++) {
        float wy = cubic((float(first.y + j) + 0.5 - center.y) / widen.y, pc.param.x, pc.param.y);
        vec3 row = vec3(0.0);
        float row_total = 0.0;
        int y = clamp(first.y + j, 0, edge.y);
        for (int i = 0; i < count.x; i++) {
            float wx = cubic((float(first.x + i) + 0.5 - center.x) / widen.x, pc.param.x, pc.param.y);
            row += wx * texelFetch(source, ivec2(clamp(first.x + i, 0, edge.x), y), 0).rgb;
            row_total += wx;
        }
        sum += wy * row, total += wy * row_total;
    }
    imageStore(dest, ivec2(at), vec4(clamp(sum / total, 0.0, 1.0), 1.0));
}
#endif

#ifdef SHARP_BILINEAR
// Sharp bilinear: as if the picture were scaled first by the largest whole
// factor that fits with nearest, then by the rest linearly. Pixels stay square
// and sharp at a ratio that is not whole; only their edges are blended.
// Downscaling it is bilinear.
void main() {
    uvec2 at = gl_GlobalInvocationID.xy;
    if (any(greaterThanEqual(at, pc.dest_size))) return;
    vec2 prescale = max(floor(pc.dest_size_f / pc.source_size), vec2(1.0));
    vec2 texel = (vec2(at) + 0.5) * pc.source_size / pc.dest_size_f;
    vec2 region = 0.5 - 0.5 / prescale;
    vec2 d = fract(texel) - 0.5;
    vec2 f = (d - clamp(d, -region, region)) * prescale + 0.5;
    vec3 color = textureLod(source, (floor(texel) + f) / pc.source_size, 0.0).rgb;
    imageStore(dest, ivec2(at), vec4(color, 1.0));
}
#endif

#if defined(SMAA_EDGES) || defined(SMAA_WEIGHTS_MEDIUM) || defined(SMAA_WEIGHTS_HIGH) ||                             \
    defined(SMAA_WEIGHTS_ULTRA) || defined(SMAA_BLEND)
// SMAA 1x (third_party/smaa/SMAA.hlsl, unchanged), its passes as compute at
// the picture's size: every pixel of each pass written (edges of zero where
// the reference discards), so no image needs clearing first. The shading
// language given as SMAA_CUSTOM_SL: the header's GLSL one, but sampling level
// 0 everywhere (compute has no implicit derivatives).
#define SMAA_CUSTOM_SL 1
#define SMAATexture2D(tex) sampler2D tex
#define SMAATexturePass2D(tex) tex
#define SMAASampleLevelZero(tex, coord) textureLod(tex, coord, 0.0)
#define SMAASampleLevelZeroPoint(tex, coord) textureLod(tex, coord, 0.0)
#define SMAASampleLevelZeroOffset(tex, coord, offset) textureLodOffset(tex, coord, 0.0, offset)
#define SMAASample(tex, coord) textureLod(tex, coord, 0.0)
#define SMAASamplePoint(tex, coord) textureLod(tex, coord, 0.0)
#define SMAASampleOffset(tex, coord, offset) textureLodOffset(tex, coord, 0.0, offset)
#define SMAA_FLATTEN
#define SMAA_BRANCH
#define lerp(a, b, t) mix(a, b, t)
#define saturate(a) clamp(a, 0.0, 1.0)
#define mad(a, b, c) fma(a, b, c)
#define SMAAGather(tex, coord) textureGather(tex, coord)
#define float2 vec2
#define float3 vec3
#define float4 vec4
#define int2 ivec2
#define int3 ivec3
#define int4 ivec4
#define bool2 bvec2
#define bool3 bvec3
#define bool4 bvec4
// where the edge detection would discard a pixel: no edge
#define discard return float2(0.0, 0.0)
#define SMAA_RT_METRICS vec4(1.0 / pc.source_size, pc.source_size)
#if defined(SMAA_EDGES)
#define SMAA_THRESHOLD pc.param.x
#elif defined(SMAA_WEIGHTS_MEDIUM)
#define SMAA_PRESET_MEDIUM 1
#elif defined(SMAA_WEIGHTS_HIGH)
#define SMAA_PRESET_HIGH 1
#elif defined(SMAA_WEIGHTS_ULTRA)
#define SMAA_PRESET_ULTRA 1
#endif
#include "../third_party/smaa/SMAA.hlsl"
void main() {
    uvec2 at = gl_GlobalInvocationID.xy;
    if (any(greaterThanEqual(at, pc.dest_size))) return;
    vec2 texcoord = (vec2(at) + 0.5) / pc.source_size;
#if defined(SMAA_EDGES)
    // luma edges (the reference's recommended detection; it wants the gamma-encoded picture this is)
    vec4 offset[3];
    SMAAEdgeDetectionVS(texcoord, offset);
    imageStore(dest, ivec2(at), vec4(SMAALumaEdgeDetectionPS(texcoord, offset, source), 0.0, 0.0));
#elif defined(SMAA_BLEND)
    // the picture in source, the blending weights in aux
    vec4 offset;
    SMAANeighborhoodBlendingVS(texcoord, offset);
    imageStore(dest, ivec2(at), vec4(SMAANeighborhoodBlendingPS(texcoord, offset, source, aux).rgb, 1.0));
#else
    // the edges in source, the area texture in aux
    vec2 pixcoord;
    vec4 offset[3];
    SMAABlendingWeightCalculationVS(texcoord, pixcoord, offset);
    imageStore(dest, ivec2(at),
               SMAABlendingWeightCalculationPS(texcoord, pixcoord, offset, source, aux, search, vec4(0.0)));
#endif
}
#endif
